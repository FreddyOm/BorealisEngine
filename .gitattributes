# Normalize line endings for all text files to LF, and for Windows batch files and Visual Studio solution files to CRLF.
* text=auto eol=lf
*.bat text eol=crlf

# C++ source code

*.c text diff=cpp
*.cpp text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp

# Always use LF line endings for shell scripts
*.sh text eol=lf